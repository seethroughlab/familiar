<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The app and, by inheritance, the Python server (ADR-0136 points 2 and 3). No read-write file
     access of any kind: the music folder is granted read-only, and zero-touch rests on that. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-only</key>
	<true/>
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Postgres's data and password, shared with the agent; and the only names under which the
	     sandbox allows Python's semaphores (ADR-0136 point 3). -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>7JL9RZ9C8P.fs</string>
	</array>
</dict>
</plist>
