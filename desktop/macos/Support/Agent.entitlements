<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The Postgres agent and Postgres's own binaries: not sandboxed, because Postgres cannot be
     (ADR-0136 point 4), but members of the app group whose container holds their data. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>7JL9RZ9C8P.fs</string>
	</array>
</dict>
</plist>
