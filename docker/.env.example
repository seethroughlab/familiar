# Familiar Configuration
# Copy this file to .env and customize for your deployment

# Infrastructure (required)
DATABASE_URL=postgresql+asyncpg://familiar:familiar@localhost:5432/familiar
REDIS_URL=redis://localhost:6379/0

# Music library path (required)
# Set this to the folder containing your music files
MUSIC_LIBRARY_PATH=

# Frontend URL — used for Spotify/Last.fm OAuth callbacks
# Default works for local use. Only change if accessing from another device
# on your network (e.g., http://192.168.1.50:4400)
FRONTEND_URL=http://localhost:4400

# Network audio outputs — WiiM / Sonos / AirPlay / Chromecast (optional)
# Auto-discovery (the "Scan for devices" button) needs the container on the LAN, which Docker bridge
# networking blocks. For a single device at a fixed IP, just register it once instead of scanning:
#   curl -X POST http://<host>:4400/api/v1/outputs -H 'content-type: application/json' \
#     -d '{"name":"WiiM","type":"upnp","device_url":"http://<device-ip>:49152/description.xml"}'
#
# DEVICE_STREAM_BASE_URL — LAN URL devices use to fetch audio.
# Leave this UNSET if you open the app at a LAN address (e.g. http://192.168.1.50:4400) — the
# browser's own origin is already device-reachable. Only set it when you reach the app over a
# network the device can't (e.g. Tailscale, a public HTTPS domain). Setting it wrongly will break
# playback that otherwise works, so don't enable it unless you need it.
# DEVICE_STREAM_BASE_URL=http://192.168.1.50:4400

# S3 Glacier Deep Archive backup (optional)
# S3_BACKUP_ACCESS_KEY_ID=AKIA...
# S3_BACKUP_SECRET_ACCESS_KEY=...

# API keys (optional — set the ones you need)
# ANTHROPIC_API_KEY=sk-ant-...       # Required for AI playlists when LLM_PROVIDER=anthropic (default)
# LASTFM_API_KEY=...                 # For scrobbling
# LASTFM_API_SECRET=...
# ACOUSTID_API_KEY=...               # For audio fingerprinting
# SPOTIFY_CLIENT_ID=...              # For album art / metadata
# SPOTIFY_CLIENT_SECRET=...

# LLM provider (optional; default: anthropic)
# Set LLM_PROVIDER=openai to use an OpenAI-compatible server for AI chat + playlist naming.
# Works with Groq, Together, OpenRouter, LocalAI, vLLM, llama.cpp, LM Studio, Ollama (/v1).
# OPENAI_BASE_URL is optional — leave unset for api.openai.com.
# Model names are required in openai mode (pick ones your endpoint actually serves).
# LLM_PROVIDER=openai
# OPENAI_API_KEY=...
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_CHAT_MODEL=llama-3.3-70b-versatile
# OPENAI_UTILITY_MODEL=llama-3.1-8b-instant

# Other settings are configured in the Settings panel (gear icon):
# - Backup bucket, region, schedule: Settings > Cloud Backup
# - Community cache: Settings > Library
