# Familiar Configuration
# Copy this file to .env and customize for your deployment

# Infrastructure (required)
DATABASE_URL=postgresql+asyncpg://familiar:familiar@localhost:5432/familiar
REDIS_URL=redis://localhost:6379/0

# Frontend URL (required for OAuth callbacks with Spotify/Last.fm)
# Change to your server's hostname/IP for remote access
FRONTEND_URL=http://localhost:4400

# S3 Glacier Deep Archive backup (optional)
# S3_BACKUP_ACCESS_KEY_ID=AKIA...
# S3_BACKUP_SECRET_ACCESS_KEY=...

# All other settings are configured via the Admin UI:
# - API keys (Anthropic, Spotify, Last.fm): /admin
# - Backup bucket, region, schedule: /admin > Cloud Backup
# - Music library paths: Settings > Library Management
