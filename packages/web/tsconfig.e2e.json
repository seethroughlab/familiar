{
  // The Playwright suite and its config. tsconfig.json covers src/ only, so a type error here went
  // unnoticed until an editor showed it; `pnpm typecheck` now runs both.
  "extends": "./tsconfig.json",
  "compilerOptions": { "noEmit": true, "types": ["node"] },
  "include": ["e2e", "playwright.config.ts"]
}
